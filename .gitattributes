# Keep line endings stable across Windows, Linux and macOS.
# The repository stores LF; every platform checks out the same bytes, so diffs
# stay clean and the deploy servers never see CRLF.
* text=auto eol=lf

# Windows scripts need CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touched by Git.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.aab binary
*.jks binary
*.keystore binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
*.zip binary
